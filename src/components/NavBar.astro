---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/publications", label: "Publications" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-slate-100">
  <nav class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-semibold text-slate-900 hover:text-indigo-600 transition-colors">
      Kamesh R
    </a>
    <ul class="flex items-center gap-1">
      {
        navLinks.map(({ href, label }) => {
          const isActive =
            href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(href);
          return (
            <li>
              <a
                href={href}
                class:list={[
                  "px-3 py-1.5 text-sm rounded-md transition-colors",
                  isActive
                    ? "text-indigo-600 font-medium bg-indigo-50"
                    : "text-slate-600 hover:text-slate-900 hover:bg-slate-50",
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
