---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/publications", label: "Publications" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200">
  <nav class="max-w-2xl mx-auto px-5 h-12 flex items-center justify-between">
    <a href="/" class="font-semibold text-slate-900 no-underline hover:text-slate-600 transition-colors">
      Kamesh R
    </a>
    <ul class="flex items-center gap-4 list-none m-0 p-0">
      {
        navLinks.map(({ href, label }) => {
          const isActive = href === "/" ? currentPath === "/" : currentPath.startsWith(href);
          return (
            <li>
              <a
                href={href}
                class:list={[
                  "text-sm no-underline transition-colors",
                  isActive ? "text-slate-900 font-medium" : "text-slate-500 hover:text-slate-900",
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
