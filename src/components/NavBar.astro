---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/publications", label: "Publications" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
];

const currentPath = Astro.url.pathname;
---

<style>
  header {
    border-bottom: 1px solid #e8e8e8;
  }
  nav {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
  }
  .site-name {
    font-weight: 600;
    color: #000;
    text-decoration: none;
  }
  .site-name:hover {
    text-decoration: none;
    color: #444;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }
  a.nav-link {
    color: #666;
    text-decoration: none;
    font-size: 0.875rem;
  }
  a.nav-link:hover {
    color: #000;
    text-decoration: none;
  }
  a.nav-link.active {
    color: #000;
    font-weight: 500;
  }
</style>

<header>
  <nav>
    <a href="/" class="site-name">Kamesh R</a>
    <ul>
      {
        navLinks.map(({ href, label }) => {
          const isActive = href === "/" ? currentPath === "/" : currentPath.startsWith(href);
          return (
            <li>
              <a href={href} class:list={["nav-link", { active: isActive }]}>
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
