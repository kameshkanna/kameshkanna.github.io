---
import type { ExperienceEntry } from "@/data/experience";

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
---

<div class="mb-5">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-0.5 mb-1">
    <p class="font-medium text-slate-900">
      {entry.role}, <span class="font-normal">{entry.org}</span>
    </p>
    <p class="text-sm text-slate-400 shrink-0">{entry.period}</p>
  </div>
  <p class="text-sm text-slate-600">{entry.bullets[0]}</p>
</div>
