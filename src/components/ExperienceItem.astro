---
import type { ExperienceEntry } from "@/data/experience";

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
---

<article class="py-5 border-b border-slate-100 last:border-0">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-2">
    <div>
      <p class="font-semibold text-slate-900">{entry.role}</p>
      <p class="text-sm text-slate-600">
        {entry.org}
        {entry.badge && (
          <span class="ml-2 badge bg-indigo-50 text-indigo-600">{entry.badge}</span>
        )}
      </p>
    </div>
    <div class="text-sm text-slate-400 sm:text-right shrink-0">
      <div>{entry.period}</div>
      <div>{entry.location}</div>
    </div>
  </div>
  <ul class="space-y-1 mt-2">
    {entry.bullets.map((b) => (
      <li class="text-sm text-slate-600 flex gap-2">
        <span class="text-slate-300 shrink-0 mt-0.5">—</span>
        <span>{b}</span>
      </li>
    ))}
  </ul>
</article>
