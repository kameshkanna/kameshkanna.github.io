---
import type { Publication } from "@/data/publications";

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const typeColors: Record<Publication["type"], string> = {
  workshop: "bg-violet-50 text-violet-700",
  conference: "bg-indigo-50 text-indigo-700",
  preprint: "bg-amber-50 text-amber-700",
};
---

<article class="py-5 border-b border-slate-100 last:border-0">
  <p class="font-medium text-slate-900 leading-snug mb-1">{pub.title}</p>
  <p class="text-sm text-slate-500 mb-2">{pub.authors}</p>
  <div class="flex flex-wrap items-center gap-2">
    <span class:list={["badge", typeColors[pub.type]]}>{pub.venue}</span>
    {
      pub.links?.arxiv && (
        <a href={pub.links.arxiv} target="_blank" rel="noopener" class="badge bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors no-underline">
          arXiv ↗
        </a>
      )
    }
    {
      pub.links?.paper && (
        <a href={pub.links.paper} target="_blank" rel="noopener" class="badge bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors no-underline">
          PDF ↗
        </a>
      )
    }
    {
      pub.links?.poster && (
        <a href={pub.links.poster} target="_blank" rel="noopener" class="badge bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors no-underline">
          Poster ↗
        </a>
      )
    }
  </div>
</article>
