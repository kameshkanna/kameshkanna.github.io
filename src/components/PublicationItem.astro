---
import type { Publication } from "@/data/publications";

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<li class="mb-4">
  <p class="text-slate-900">
    {pub.links?.arxiv ? (
      <a href={pub.links.arxiv} target="_blank" rel="noopener">{pub.title}</a>
    ) : pub.links?.paper ? (
      <a href={pub.links.paper} target="_blank" rel="noopener">{pub.title}</a>
    ) : (
      <span class="font-medium">{pub.title}</span>
    )}
  </p>
  <p class="text-sm text-slate-600">
    {pub.authors} · <em>{pub.venue}</em>
    {pub.links?.poster && (
      <> · <a href={pub.links.poster} target="_blank" rel="noopener" class="text-sm">poster</a></>
    )}
  </p>
</li>
