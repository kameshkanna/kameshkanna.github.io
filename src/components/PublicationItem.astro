---
import type { Publication } from "@/data/publications";

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<div style="margin-bottom: 1.1rem;">
  <p style="margin: 0 0 0.15rem; font-weight: 500; color: #000; line-height: 1.4;">
    {pub.links?.arxiv ? (
      <a href={pub.links.arxiv} target="_blank" rel="noopener" style="font-weight: 500; text-decoration: none; color: #000; border-bottom: 1px solid #bbb;">{pub.title}</a>
    ) : pub.links?.paper ? (
      <a href={pub.links.paper} target="_blank" rel="noopener" style="font-weight: 500; text-decoration: none; color: #000; border-bottom: 1px solid #bbb;">{pub.title}</a>
    ) : (
      pub.title
    )}
  </p>
  <p style="margin: 0; font-size: 0.875rem; color: #555;">
    {pub.authors} &nbsp;·&nbsp; <em>{pub.venue}</em>
  </p>
</div>
