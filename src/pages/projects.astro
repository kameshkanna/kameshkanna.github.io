---
import Layout from "@/layouts/Layout.astro";
import { projects, grants, service } from "@/data/projects";
import { experience } from "@/data/experience";
import { talks } from "@/data/talks";
---

<Layout title="Projects — Kamesh R" description="Research projects, talks, and more.">
  <h1 class="text-xl font-semibold text-slate-900 mb-8">Projects</h1>

  <!-- Research Projects -->
  <section>
    <h2 class="section-title">Research Projects</h2>
    {
      projects.map((project) => (
        <div class="mb-6">
          <p class="font-medium text-slate-900 text-[15px] mb-0.5">{project.title}</p>
          <p class="text-sm text-slate-600 mb-2">{project.description}</p>
          <p class="text-sm text-slate-600">{project.bullets[0]}</p>
          {(project.links?.github || project.links?.paper) && (
            <p class="text-sm mt-1.5 flex gap-3">
              {project.links?.github && <a href={project.links.github} target="_blank" rel="noopener">GitHub</a>}
              {project.links?.paper && <a href={project.links.paper} target="_blank" rel="noopener">Paper</a>}
            </p>
          )}
        </div>
      ))
    }
  </section>

  <!-- Full Experience -->
  <section>
    <h2 class="section-title">Experience</h2>
    {
      experience.map((entry) => (
        <div class="mb-4">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-0.5 mb-0.5">
            <p class="text-[15px] font-medium text-slate-900">
              {entry.role}, <span class="font-normal text-slate-700">{entry.org}</span>
            </p>
            <p class="text-sm text-slate-400 shrink-0">{entry.period}</p>
          </div>
          <ul class="list-none m-0 p-0 space-y-0.5">
            {entry.bullets.map((b) => (
              <li class="text-sm text-slate-600">{b}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- Talks -->
  <section>
    <h2 class="section-title">Talks & Seminars</h2>
    <ul class="list-none m-0 p-0">
      {
        talks.map((talk) => (
          <li class="mb-3">
            <p class="text-[15px] text-slate-900">{talk.title}</p>
            <p class="text-sm text-slate-500">{talk.venue}, {talk.year}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Grants -->
  <section>
    <h2 class="section-title">Grants</h2>
    {
      grants.map((grant) => (
        <div class="mb-4">
          <p class="font-medium text-[15px] text-slate-900">{grant.title} <span class="font-normal text-slate-500">({grant.amount})</span></p>
          <p class="text-sm text-slate-600">{grant.description}</p>
        </div>
      ))
    }
  </section>

  <!-- Service -->
  <section>
    <h2 class="section-title">Service</h2>
    <ul class="list-none m-0 p-0">
      {
        service.map((s) => (
          <li class="text-sm text-slate-600 mb-1.5">
            {s.role} — {s.venue}
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
