---
import Layout from "@/layouts/Layout.astro";
import { projects, grants, service } from "@/data/projects";
import { experience, education } from "@/data/experience";
import { talks } from "@/data/talks";
---

<Layout title="Projects — Kamesh R" description="Projects, experience, talks, and more.">
  <h1 style="margin-bottom: 0.25rem;">Projects &amp; Experience</h1>
  <p style="color: #555; font-size: 0.875rem; margin-top: 0;">
    <a href="/cv.pdf" target="_blank">Full CV (PDF)</a>
  </p>

  <!-- Research Projects -->
  <h2>Research Projects</h2>
  {projects.map((project) => (
    <div style="margin-bottom: 1.5rem;">
      <p style="margin: 0 0 0.2rem; font-weight: 500; color: #000;">{project.title}</p>
      <p style="margin: 0 0 0.3rem; font-size: 0.875rem; color: #444;">{project.description}</p>
      {project.bullets.map((b) => (
        <p style="margin: 0 0 0.2rem; font-size: 0.875rem; color: #555; padding-left: 1rem;">{b}</p>
      ))}
      {(project.links?.github || project.links?.paper) && (
        <p style="margin: 0.3rem 0 0; font-size: 0.875rem;">
          {project.links?.github && <a href={project.links.github} target="_blank" rel="noopener">GitHub</a>}
          {project.links?.github && project.links?.paper && <span style="color: #888;"> &nbsp;/&nbsp; </span>}
          {project.links?.paper && <a href={project.links.paper} target="_blank" rel="noopener">Paper</a>}
        </p>
      )}
    </div>
  ))}

  <!-- Education -->
  <h2>Education</h2>
  {education.map((ed) => (
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.25rem;">
      <div>
        <span style="font-weight: 500; color: #000;">
          {ed.institution}
          {ed.upcoming && <span style="font-weight: 400; color: #888; font-size: 0.8rem;"> (upcoming)</span>}
        </span>
        <span style="color: #555; font-size: 0.875rem;"> — {ed.degree}</span>
      </div>
      <span style="color: #888; font-size: 0.875rem; white-space: nowrap;">{ed.period}</span>
    </div>
  ))}

  <!-- Experience -->
  <h2>Experience</h2>
  {experience.map((entry) => (
    <div style="margin-bottom: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.3rem;">
        <p style="margin: 0; font-weight: 500; color: #000;">
          {entry.role}, <span style="font-weight: 400;">{entry.org}</span>
        </p>
        <span style="color: #888; font-size: 0.875rem; white-space: nowrap;">{entry.period}</span>
      </div>
      {entry.bullets.map((b) => (
        <p style="margin: 0 0 0.2rem; font-size: 0.875rem; color: #555;">{b}</p>
      ))}
    </div>
  ))}

  <!-- Talks -->
  <h2>Talks &amp; Seminars</h2>
  {talks.map((talk) => (
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; flex-wrap: wrap; gap: 0.25rem;">
      <div>
        <span style="color: #111;">{talk.title}</span>
        <span style="color: #666; font-size: 0.875rem;"> &nbsp;·&nbsp; {talk.venue}</span>
      </div>
      <span style="color: #888; font-size: 0.875rem; white-space: nowrap;">{talk.year}</span>
    </div>
  ))}

  <!-- Grants -->
  <h2>Grants</h2>
  {grants.map((grant) => (
    <div style="margin-bottom: 1rem;">
      <p style="margin: 0 0 0.2rem;">
        <span style="font-weight: 500; color: #000;">{grant.title}</span>
        <span style="color: #666; font-size: 0.875rem;"> ({grant.amount})</span>
      </p>
      <p style="margin: 0; font-size: 0.875rem; color: #555;">{grant.description}</p>
    </div>
  ))}

  <!-- Service -->
  <h2>Service</h2>
  {service.map((s) => (
    <p style="margin: 0 0 0.4rem; font-size: 0.875rem; color: #444;">
      {s.role} — {s.venue}
    </p>
  ))}
</Layout>
