---
import Layout from "@/layouts/Layout.astro";
import { projects, grants, service } from "@/data/projects";
import { experience, education } from "@/data/experience";
import { talks } from "@/data/talks";
---

<Layout title="Projects — Kamesh R" description="Projects, experience, talks, and more.">

  <h1 class="reveal">Projects &amp; Experience</h1>
  <p class="meta reveal" style="margin:0.4rem 0 0;">
    <a href="/cv.pdf" target="_blank">Download CV (PDF)</a>
  </p>

  <!-- ── Education ── -->
  <h2 class="reveal">Education</h2>
  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:0.75rem;">
    {education.map((ed) => (
      <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:0.25rem;">
        <div>
          <span style="font-weight:600; font-size:0.9375rem; color:var(--ink);">{ed.institution}</span>
          <span class="meta">&ensp;—&ensp;{ed.degree}</span>
        </div>
        <span class="meta" style="white-space:nowrap;">{ed.period}</span>
      </div>
    ))}
  </div>

  <!-- ── Research Projects ── -->
  <h2 class="reveal">Research Projects</h2>
  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:1.25rem;">
    {projects.map((project) => (
      <div>
        <h3>{project.title}</h3>
        <p style="margin:0.2rem 0 0.4rem; font-size:0.9375rem; color:#333;">{project.description}</p>
        <div style="display:flex; flex-direction:column; gap:0.2rem;">
          {project.bullets.map((b) => (
            <p class="meta" style="margin:0; padding-left:1rem; border-left:2px solid var(--line);">{b}</p>
          ))}
        </div>
        {(project.links?.github || project.links?.paper) && (
          <p style="margin:0.4rem 0 0; font-size:0.875rem;">
            {project.links?.github && <a href={project.links.github} target="_blank" rel="noopener">GitHub</a>}
            {project.links?.github && project.links?.paper && <>&ensp;/&ensp;</>}
            {project.links?.paper && <a href={project.links.paper} target="_blank" rel="noopener">Paper</a>}
          </p>
        )}
      </div>
    ))}
  </div>

  <!-- ── Experience ── -->
  <h2 class="reveal">Experience</h2>
  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:1.25rem;">
    {experience.map((entry) => (
      <div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:0.25rem; margin-bottom:0.35rem;">
          <h3 style="margin:0;">
            {entry.role}<span style="font-weight:400; color:#444;">,&ensp;{entry.org}</span>
          </h3>
          <span class="meta" style="white-space:nowrap;">{entry.period}</span>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.2rem;">
          {entry.bullets.map((b) => (
            <p class="meta" style="margin:0;">{b}</p>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- ── Talks ── -->
  <h2 class="reveal">Talks &amp; Seminars</h2>
  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:0.6rem;">
    {talks.map((talk) => (
      <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:0.25rem;">
        <div>
          <span style="font-size:0.9375rem; color:#111;">{talk.title}</span>
          <span class="meta">&ensp;·&ensp;{talk.venue}</span>
        </div>
        <span class="meta" style="white-space:nowrap;">{talk.year}</span>
      </div>
    ))}
  </div>

  <!-- ── Grants ── -->
  <h2 class="reveal">Grants</h2>
  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:0.75rem;">
    {grants.map((grant) => (
      <div>
        <p style="margin:0 0 0.2rem;">
          <span style="font-weight:600; font-size:0.9375rem;">{grant.title}</span>
          <span class="meta">&ensp;({grant.amount})</span>
        </p>
        <p class="meta" style="margin:0;">{grant.description}</p>
      </div>
    ))}
  </div>

  <!-- ── Service ── -->
  <h2 class="reveal">Service</h2>
  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:0.4rem;">
    {service.map((s) => (
      <p class="meta" style="margin:0;">{s.role}&ensp;—&ensp;{s.venue}</p>
    ))}
  </div>

</Layout>
