---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/data/profile";

const hasLessWrong = profile.links.lesswrong !== "YOUR_LESSWRONG_URL";
---

<Layout title="Writing — Kamesh R" description="Writing by Kamesh R on AI safety, interpretability, and reasoning.">
  <h1 class="text-xl font-semibold text-slate-900 mb-8">Writing</h1>

  <section class="text-[15px] text-slate-700 space-y-4">
    <p>
      I write occasionally about AI safety, mechanistic interpretability, and reasoning —
      things I'm actively working on or thinking through.
    </p>
    {hasLessWrong ? (
      <p>
        Most of my writing is on <a href={profile.links.lesswrong} target="_blank" rel="noopener">LessWrong</a>.
      </p>
    ) : (
      <p>
        I plan to start writing on <a href="https://www.lesswrong.com" target="_blank" rel="noopener">LessWrong</a> soon.
        For now, see my <a href="/publications">publications</a>.
      </p>
    )}
  </section>
</Layout>
