---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/data/profile";

const hasLessWrong = profile.links.lesswrong !== "YOUR_LESSWRONG_URL";
---

<Layout title="Writing — Kamesh R" description="Writing by Kamesh R on AI safety and interpretability.">
  <h1 style="margin-bottom: 1.5rem;">Writing</h1>

  <div style="line-height: 1.7; color: #222;">
    <p style="margin: 0 0 0.9rem;">
      I write occasionally about AI safety, mechanistic interpretability, and reasoning —
      things I'm actively working on or thinking through.
    </p>
    {hasLessWrong ? (
      <p style="margin: 0;">
        Most of it is on <a href={profile.links.lesswrong} target="_blank" rel="noopener">LessWrong</a>.
      </p>
    ) : (
      <p style="margin: 0;">
        I plan to start posting on <a href="https://www.lesswrong.com" target="_blank" rel="noopener">LessWrong</a> soon.
        In the meantime, see my <a href="/publications">publications</a>.
      </p>
    )}
  </div>
</Layout>
