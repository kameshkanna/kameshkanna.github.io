---
import Layout from "@/layouts/Layout.astro";
import { writing } from "@/data/writing";

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

<Layout title="Writing · Kamesh R" description="Technical writing by Kamesh R on AI safety and interpretability.">

  <h1 class="reveal">Writing</h1>
  <p class="meta reveal" style="margin:0.4rem 0 1.5rem;">
    Notes on interpretability and steering, posted on <a href="https://www.lesswrong.com/users/kamesh-r" target="_blank" rel="noopener">LessWrong</a>.
  </p>

  <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:1.75rem;">
    {writing.map((post) => (
      <div>
        <h3><a href={post.url} target="_blank" rel="noopener">{post.title}</a></h3>
        <p style="margin:0.3rem 0 0.35rem; font-size:0.875rem; color:#444; line-height:1.65;">{post.summary}</p>
        <p class="meta" style="margin:0;">{formatDate(post.date)}</p>
      </div>
    ))}
  </div>

</Layout>
