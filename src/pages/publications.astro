---
import Layout from "@/layouts/Layout.astro";
import { publications } from "@/data/publications";

const byYear = publications.reduce<Record<number, typeof publications>>((acc, pub) => {
  if (!acc[pub.year]) acc[pub.year] = [];
  acc[pub.year].push(pub);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Layout title="Publications — Kamesh R" description="Research publications by Kamesh R.">

  <h1 class="reveal">Publications</h1>
  <p class="meta reveal" style="margin:0.4rem 0 0;">AI safety, reasoning evaluation, multilingual NLP.</p>

  {years.map((year) => (
    <div class="reveal">
      <h2>{year}</h2>
      <div class="reveal-stagger" style="display:flex; flex-direction:column; gap:1rem;">
        {byYear[year].map((pub) => (
          <div>
            <h3>
              {pub.links?.arxiv
                ? <a href={pub.links.arxiv} target="_blank" rel="noopener">{pub.title}</a>
                : pub.links?.paper
                ? <a href={pub.links.paper} target="_blank" rel="noopener">{pub.title}</a>
                : pub.title}
            </h3>
            <p class="meta" style="margin:0;">
              {pub.authors}&ensp;·&ensp;<em>{pub.venue}</em>
              {pub.links?.poster && pub.links.poster !== "#" && <>&ensp;[<a href={pub.links.poster} target="_blank" rel="noopener">poster</a>]</>}
            </p>
          </div>
        ))}
      </div>
    </div>
  ))}

</Layout>
