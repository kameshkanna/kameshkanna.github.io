---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/data/profile";
import { publications } from "@/data/publications";
import { experience, education } from "@/data/experience";
import { projects, grants, service } from "@/data/projects";
import { talks } from "@/data/talks";
import { skills } from "@/data/skills";
---

<Layout
  title="Kamesh R"
  description="ML researcher working on AI safety and interpretability."
  showNav={false}
>

<style>
  /* ── Sticky nav ── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    height: 46px;
    max-width: 100%;
  }
  .site-nav a { text-decoration: none; color: #666; font-size: 0.8125rem; }
  .site-nav a:hover { color: #000; text-decoration: none; }
  .site-nav .brand { font-weight: 700; color: #000; font-size: 0.9rem; letter-spacing: -0.01em; }
  .site-nav .anchor-links { display: flex; gap: 1.5rem; }

  /* ── Section dividers ── */
  .section-divider {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 3rem 0;
  }

  /* ── Section headings ── */
  .section-title {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin: 0 0 1.5rem;
  }

  /* ── Hero ── */
  .hero { display: flex; gap: 2rem; align-items: flex-start; }
  .hero-text { flex: 1; min-width: 0; }
  .hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #000;
    margin: 0 0 0.5rem;
  }
  .hero-role {
    font-size: 0.875rem;
    color: #555;
    margin: 0 0 1.1rem;
    line-height: 1.5;
  }
  .hero-links {
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.1rem;
    line-height: 2;
  }
  .hero-links a { color: #111; text-decoration: none; border-bottom: 1px solid #bbb; }
  .hero-links a:hover { border-bottom-color: #000; }
  .hero-links .sep { color: #ccc; padding: 0 0.4rem; }
  .hero-photo {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  /* ── Bio ── */
  .bio p { margin: 0 0 0.85rem; font-size: 0.9375rem; color: #222; line-height: 1.75; }
  .bio p:last-child { margin-bottom: 0; }

  /* ── Publications ── */
  .pub-list { display: flex; flex-direction: column; gap: 1.1rem; }
  .pub-item {}
  .pub-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #000;
    line-height: 1.4;
    margin: 0 0 0.2rem;
  }
  .pub-title a { color: #000; text-decoration: none; border-bottom: 1px solid #ccc; }
  .pub-title a:hover { border-bottom-color: #000; }
  .pub-meta { font-size: 0.8125rem; color: #666; margin: 0; line-height: 1.5; }
  .pub-meta a { color: #666; border-bottom: 1px solid #ddd; text-decoration: none; }
  .pub-meta a:hover { color: #000; }

  /* ── Experience ── */
  .exp-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .exp-item { padding-left: 1rem; border-left: 2px solid #e8e8e8; }
  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.35rem;
  }
  .exp-role { font-size: 0.9375rem; font-weight: 600; color: #000; }
  .exp-org { font-weight: 400; color: #444; }
  .exp-period { font-size: 0.8125rem; color: #888; white-space: nowrap; }
  .exp-bullets { display: flex; flex-direction: column; gap: 0.2rem; }
  .exp-bullet { font-size: 0.8125rem; color: #555; margin: 0; line-height: 1.6; }

  /* ── Education ── */
  .edu-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .edu-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem;
  }
  .edu-inst { font-size: 0.9375rem; font-weight: 600; color: #000; }
  .edu-degree { font-size: 0.8125rem; color: #555; }
  .edu-period { font-size: 0.8125rem; color: #888; white-space: nowrap; }
  .upcoming-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    color: #888;
    border: 1px solid #ddd;
    padding: 0 0.3rem;
    border-radius: 3px;
    margin-left: 0.35rem;
    vertical-align: middle;
  }

  /* ── Projects ── */
  .project-list { display: flex; flex-direction: column; gap: 1.4rem; }
  .project-title { font-size: 0.9375rem; font-weight: 600; color: #000; margin: 0 0 0.25rem; }
  .project-desc { font-size: 0.875rem; color: #444; margin: 0 0 0.4rem; line-height: 1.6; }
  .project-highlight { font-size: 0.8125rem; color: #666; margin: 0; line-height: 1.6; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; }
  .tag {
    font-size: 0.6875rem;
    color: #777;
    border: 1px solid #ddd;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  /* ── Grants ── */
  .grant-title { font-size: 0.9375rem; font-weight: 600; color: #000; margin: 0 0 0.2rem; }
  .grant-amount { font-weight: 400; color: #666; font-size: 0.875rem; }
  .grant-desc { font-size: 0.8125rem; color: #555; margin: 0; line-height: 1.6; }

  /* ── Talks ── */
  .talk-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .talk-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .talk-title { font-size: 0.9375rem; color: #111; }
  .talk-venue { font-size: 0.8125rem; color: #666; }
  .talk-year { font-size: 0.8125rem; color: #999; white-space: nowrap; }

  /* ── Service ── */
  .service-list { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 1rem; }
  .service-item { font-size: 0.8125rem; color: #555; margin: 0; }

  /* ── Skills ── */
  .skills-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .skill-row { display: flex; gap: 0.75rem; font-size: 0.875rem; align-items: baseline; flex-wrap: wrap; }
  .skill-label { font-weight: 600; color: #000; min-width: 7rem; flex-shrink: 0; font-size: 0.8125rem; }
  .skill-items { color: #444; line-height: 1.6; }

  /* ── Footer ── */
  .site-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e8e8e8;
    font-size: 0.8125rem;
    color: #aaa;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .site-footer a { color: #888; text-decoration: none; border-bottom: 1px solid #ddd; }
  .site-footer a:hover { color: #000; }

  @media (max-width: 520px) {
    .hero { flex-direction: column-reverse; gap: 1.25rem; }
    .hero-photo { width: 90px; height: 90px; }
    .hero h1 { font-size: 2.1rem; }
    .site-nav .anchor-links { gap: 1rem; }
    .site-nav .anchor-links a:nth-child(n+5) { display: none; }
  }
</style>

<!-- ── Sticky navigation ── -->
<nav class="site-nav" style="margin-left:-1.25rem; margin-right:-1.25rem; margin-top:-2.5rem; margin-bottom:2.5rem; width:calc(100% + 2.5rem);">
  <a href="#top" class="brand">Kamesh R</a>
  <div class="anchor-links">
    <a href="#about">About</a>
    <a href="#publications">Papers</a>
    <a href="#experience">Experience</a>
    <a href="#projects">Projects</a>
    <a href="#talks">Talks</a>
    <a href="/writing">Writing</a>
  </div>
</nav>

<!-- ── Hero ── -->
<section id="top">
  <div class="hero">
    <div class="hero-text">
      <h1>Kamesh R</h1>
      <p class="hero-role">
        ML Intern, Glance &ensp;·&ensp; MSc Machine Learning, UCL (Aug 2026)
      </p>
      <p class="hero-links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <span class="sep">/</span>
        <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
        <span class="sep">/</span>
        <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <span class="sep">/</span>
        <a href={profile.links.scholar} target="_blank" rel="noopener">Scholar</a>
        <span class="sep">/</span>
        <a href={profile.links.twitter} target="_blank" rel="noopener">Twitter</a>
        <span class="sep">/</span>
        <a href={profile.links.cv} target="_blank">CV</a>
      </p>
    </div>
    <img src="/images/profile.jpg" alt="Kamesh R" class="hero-photo" />
  </div>
</section>

<hr class="section-divider" />

<!-- ── About ── -->
<section id="about">
  <p class="section-title">About</p>
  <div class="bio">
    {profile.bio.map((para) => <p>{para}</p>)}
  </div>
</section>

<hr class="section-divider" />

<!-- ── Publications ── -->
<section id="publications">
  <p class="section-title">Publications</p>
  <div class="pub-list">
    {publications.map((pub) => (
      <div class="pub-item">
        <p class="pub-title">
          {pub.links?.arxiv
            ? <a href={pub.links.arxiv} target="_blank" rel="noopener">{pub.title}</a>
            : pub.links?.paper
            ? <a href={pub.links.paper} target="_blank" rel="noopener">{pub.title}</a>
            : pub.title}
        </p>
        <p class="pub-meta">
          {pub.authors}&ensp;·&ensp;<em>{pub.venue}</em>
          {pub.links?.poster && <>&ensp;<a href={pub.links.poster} target="_blank" rel="noopener">[poster]</a></>}
        </p>
      </div>
    ))}
  </div>
</section>

<hr class="section-divider" />

<!-- ── Experience ── -->
<section id="experience">
  <p class="section-title">Experience</p>
  <div class="exp-list">
    {experience.map((entry) => (
      <div class="exp-item">
        <div class="exp-header">
          <span class="exp-role">
            {entry.role}<span class="exp-org">,&ensp;{entry.org}</span>
          </span>
          <span class="exp-period">{entry.period}</span>
        </div>
        <div class="exp-bullets">
          {entry.bullets.map((b) => <p class="exp-bullet">{b}</p>)}
        </div>
      </div>
    ))}
  </div>
</section>

<hr class="section-divider" />

<!-- ── Education ── -->
<section id="education">
  <p class="section-title">Education</p>
  <div class="edu-list">
    {education.map((ed) => (
      <div class="edu-item">
        <div>
          <span class="edu-inst">
            {ed.institution}
            {ed.upcoming && <span class="upcoming-tag">upcoming</span>}
          </span>
          <span class="edu-degree">&ensp;—&ensp;{ed.degree}</span>
        </div>
        <span class="edu-period">{ed.period}</span>
      </div>
    ))}
  </div>
</section>

<hr class="section-divider" />

<!-- ── Projects ── -->
<section id="projects">
  <p class="section-title">Research Projects</p>
  <div class="project-list">
    {projects.map((project) => (
      <div>
        <p class="project-title">{project.title}</p>
        <p class="project-desc">{project.description}</p>
        <p class="project-highlight">{project.bullets[0]}</p>
        <div class="project-tags">
          {project.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>

  <div style="margin-top:2rem;">
    <p class="section-title" style="margin-bottom:1rem;">Grants</p>
    {grants.map((grant) => (
      <div style="margin-bottom:0.75rem;">
        <p class="grant-title">{grant.title} <span class="grant-amount">({grant.amount})</span></p>
        <p class="grant-desc">{grant.description}</p>
      </div>
    ))}
  </div>
</section>

<hr class="section-divider" />

<!-- ── Talks & Service ── -->
<section id="talks">
  <p class="section-title">Talks &amp; Seminars</p>
  <div class="talk-list">
    {talks.map((talk) => (
      <div class="talk-item">
        <div>
          <span class="talk-title">{talk.title}</span>
          <span class="talk-venue">&ensp;·&ensp;{talk.venue}</span>
        </div>
        <span class="talk-year">{talk.year}</span>
      </div>
    ))}
  </div>

  <p class="section-title" style="margin-top:2rem; margin-bottom:0.75rem;">Academic Service</p>
  <div class="service-list">
    {service.map((s) => (
      <p class="service-item">{s.role}&ensp;—&ensp;{s.venue}</p>
    ))}
  </div>
</section>

<hr class="section-divider" />

<!-- ── Skills ── -->
<section id="skills">
  <p class="section-title">Skills</p>
  <div class="skills-list">
    {skills.map((group) => (
      <div class="skill-row">
        <span class="skill-label">{group.label}</span>
        <span class="skill-items">{group.items.join(", ")}</span>
      </div>
    ))}
  </div>
</section>

<!-- ── Footer ── -->
<footer class="site-footer">
  <span>Kamesh R · {new Date().getFullYear()}</span>
  <span>
    <a href="/cv.pdf" target="_blank">CV (PDF)</a>
    &ensp;·&ensp;
    <a href="/publications">All papers</a>
    &ensp;·&ensp;
    <a href="/writing">Writing</a>
  </span>
</footer>

</Layout>

<script>
  // Highlight active nav link based on scroll position
  const sections = ["about","publications","experience","education","projects","talks","skills"];
  const links = document.querySelectorAll<HTMLAnchorElement>(".anchor-links a");

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        links.forEach((l) => {
          const href = l.getAttribute("href")?.slice(1);
          l.style.color = href === id ? "#000" : "";
          l.style.fontWeight = href === id ? "600" : "";
        });
      }
    });
  }, { rootMargin: "-40% 0px -55% 0px" });

  sections.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
