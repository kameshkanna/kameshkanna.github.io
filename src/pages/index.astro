---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/data/profile";
import { publications } from "@/data/publications";
---

<Layout title="Kamesh R" description="ML researcher working on AI safety and interpretability.">

  <!-- ── Hero ── -->
  <div style="display:flex; gap:1.75rem; align-items:flex-start; margin-bottom:1.5rem;">
    <div style="flex:1; min-width:0;">
      <h1>Kamesh R</h1>
      <p class="meta" style="margin:0.4rem 0 1rem;">
        ML Intern, <a href="https://glance.com" target="_blank" rel="noopener" class="no-underline" style="color:#444;">Glance</a>
        &ensp;·&ensp;
        MSc Machine Learning, UCL (Aug 2026)
      </p>
      <p style="font-size:0.875rem; line-height:1.8; margin:0; display:flex; flex-wrap:wrap; gap:0.1rem 0;">
        <a href={`mailto:${profile.email}`}>Email</a>&ensp;/&ensp;<a
          href={profile.links.github} target="_blank" rel="noopener">GitHub</a>&ensp;/&ensp;<a
          href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>&ensp;/&ensp;<a
          href={profile.links.scholar} target="_blank" rel="noopener">Scholar</a>&ensp;/&ensp;<a
          href={profile.links.twitter} target="_blank" rel="noopener">Twitter</a>&ensp;/&ensp;<a
          href={profile.links.cv} target="_blank">CV</a>
      </p>
    </div>
    <img
      src="/images/profile.jpg"
      alt="Kamesh R"
      style="width:108px; height:108px; object-fit:cover; border-radius:5px; flex-shrink:0;"
    />
  </div>

  <!-- ── Bio ── -->
  <div style="display:flex; flex-direction:column; gap:0.8rem;">
    {profile.bio.map((para) => <p style="margin:0;">{para}</p>)}
  </div>

  <!-- ── Publications ── -->
  <h2>Publications</h2>

  <div style="display:flex; flex-direction:column; gap:1rem;">
    {publications.map((pub) => (
      <div>
        <h3>
          {pub.links?.arxiv
            ? <a href={pub.links.arxiv} target="_blank" rel="noopener">{pub.title}</a>
            : pub.links?.paper
            ? <a href={pub.links.paper} target="_blank" rel="noopener">{pub.title}</a>
            : pub.title}
        </h3>
        <p class="meta" style="margin:0;">
          {pub.authors}&ensp;·&ensp;<em>{pub.venue}</em>
          {pub.links?.poster && <>&ensp;[<a href={pub.links.poster} target="_blank" rel="noopener">poster</a>]</>}
        </p>
      </div>
    ))}
  </div>

  <!-- ── Footer nav ── -->
  <p class="meta" style="margin-top:2.5rem; padding-top:1.25rem; border-top:1px solid #eee;">
    <a href="/projects">Projects &amp; experience</a>
    &ensp;·&ensp;
    <a href="/publications">All publications</a>
    &ensp;·&ensp;
    <a href="/writing">Writing</a>
  </p>

</Layout>
